#!/bin/bash
### BEGIN INIT INFO
# Provides:          ni-cgroups
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     4 5
# Default-Stop:      0 6
# Short-Description: Setup cgroups for LabVIEW RT & assign tasks
### END INIT INFO

identify_lvrt_cgroup_version() {
    local cpu_arch lvrt_installed lvrt_version major_version

    # Detect CPU architecture (ARM → always cgroups v1)
    cpu_arch="$(uname -m)"
    case "$cpu_arch" in
        arm*|aarch64)
            echo 1
            return
            ;;
    esac

    # Check if LabVIEW RT package is installed
    lvrt_installed=$(opkg list-installed ni-labview-realtime 2>/dev/null)

    # If not installed → default to cgroups v2
    if [ -z "$lvrt_installed" ]; then
        echo 2
        return
    fi

    # LVRT is installed → parse version
    lvrt_version=$(awk '{print $3}' <<<"$lvrt_installed")
    major_version=${lvrt_version%%.*}

    # LVRT ≤ 2025 → cgroups v1
    if [ -n "$major_version" ] && [ "$major_version" -le 25 ]; then
        echo 1
    else
        echo 2
    fi
}

LVRT_CGROUP_VERSION=$(identify_lvrt_cgroup_version)

if [ "$LVRT_CGROUP_VERSION" -eq 1 ]; then
    /etc/init.d/ni-cgroups-v1 "$1"
else
    /etc/init.d/ni-cgroups-v2 "$1"
fi
